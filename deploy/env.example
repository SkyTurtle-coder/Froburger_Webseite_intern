DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=intern.avfroburger.ch,intern-avfroburger.ch,179.237.81.250,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://intern.avfroburger.ch,https://intern-avfroburger.ch
# Optional temporarily during DNS/http-only validation:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://intern.avfroburger.ch,http://intern.avfroburger.ch
DB_NAME=avf_intern
DB_USER=avf_django
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306
STATIC_ROOT=/srv/avf-intern/static
MEDIA_ROOT=/srv/avf-intern/media
PUBLIC_EVENT_SOURCE_BASE_URL=http://179.237.81.250
PUBLIC_MEDIA_BASE_URL=http://179.237.81.250/media/
PUBLIC_EVENT_DETAIL_PATH_PREFIX=/anlaesse
PUBLIC_WEBSITE_PRIMARY_URL=https://test.avfroburger.ch/
PUBLIC_WEBSITE_FALLBACK_URL=https://avfroburger.ch/
# Required: see .env.production.example for details (SEC-005). An empty value
# does not disable auth - it disables the signup endpoint entirely (fail-closed).
PUBLIC_EVENT_SIGNUP_SHARED_SECRET=replace-with-a-long-random-shared-secret
DJANGO_ENABLE_PROXY_SSL_HEADER=True
DJANGO_USE_X_FORWARDED_HOST=True
# DNS + Certbot have been live since the "Naechster Schritt nach DNS" step below
# was completed - these must stay True. Only ever set them False again for a
# brand-new host during the brief pre-DNS/pre-TLS bring-up window, and flip
# them back the moment step 5 below is done.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=15552000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_X_FRAME_OPTIONS=DENY
