DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=intern.avfroburger.ch,intern-avfroburger.ch,179.237.81.250,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://intern.avfroburger.ch,https://intern-avfroburger.ch
DB_NAME=avf_intern
DB_USER=avf_django
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.infomaniak.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@intern-avfroburger.ch
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="AV Froburger Intern <noreply@intern-avfroburger.ch>"
PASSWORD_RESET_TIMEOUT=7200
STATIC_ROOT=/srv/avf-intern/static
MEDIA_ROOT=/srv/avf-intern/media
PUBLIC_EVENT_SOURCE_BASE_URL=https://intern.avfroburger.ch
PUBLIC_MEDIA_BASE_URL=https://intern.avfroburger.ch/media/
PUBLIC_EVENT_DETAIL_PATH_PREFIX=/anlaesse
PUBLIC_WORDPRESS_SITE_URL=https://www.avfroburger.ch
CALENDAR_PUBLIC_FEED_URL=https://intern.avfroburger.ch/calendar/public/events.ics
CALENDAR_PAST_RETENTION_DAYS=90
CALENDAR_FUTURE_HORIZON_DAYS=730

# Required: shared secret WordPress uses to authenticate server-to-server calls
# to the public event-signup API (events/public_views.py, SEC-005). Generate
# with e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"` and
# configure the SAME value as AVF_EVENTS_SIGNUP_SHARED_SECRET on the WordPress
# side. Leaving this unset does NOT open the endpoint - it disables signups
# entirely (fails closed) until a real secret is configured on both sides.
PUBLIC_EVENT_SIGNUP_SHARED_SECRET=replace-with-a-long-random-shared-secret

# This template targets a host that already terminates TLS (see deploy/DEPLOYMENT.md).
# Only relax these to False temporarily during initial DNS/TLS bring-up.
DJANGO_ENABLE_PROXY_SSL_HEADER=True
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Stepped-up HSTS once HTTPS is confirmed stable on all hosts covered by
# includeSubDomains (180 days). Raise towards 63072000 (2 years) and only
# consider SECURE_HSTS_PRELOAD as a separate, deliberate decision afterwards
# (see SEC-010) - preloading is effectively permanent and hard to reverse.
DJANGO_SECURE_HSTS_SECONDS=15552000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_X_FRAME_OPTIONS=DENY
